# Booking BFF local configuration (ARCHITECTURE §15).
# Copy this file to .dev.vars for `wrangler dev`. Never commit .dev.vars or .env.
# Defaults run both Setmore and Square in mock mode. Secrets stay empty here;
# production secrets are set with `wrangler secret put`.

ENVIRONMENT=development
ALLOWED_ORIGINS=http://localhost:8787,https://perfectionbyriri.com
STUDIO_TIMEZONE=America/Los_Angeles

SETMORE_MOCK_MODE=true
SETMORE_MOCK_SCENARIO=normal
SETMORE_MOCK_429_COUNT=3
SETMORE_API_BASE=https://developer.setmore.com/api/v2
# Secret: the Setmore refresh token. Only needed with SETMORE_MOCK_MODE=false.
SETMORE_REFRESH_TOKEN=
SETMORE_ACCOUNT_ID=1a47bbdd-c70e-402d-9bcb-1c739d6752ae
SETMORE_PROVIDER_ID=b0bfa3b4-b043-4cec-b841-017a716974fd

TOKEN_REFRESH_MARGIN_SECONDS=60
CATALOG_TTL_SECONDS=600
SLOTS_TTL_SECONDS=30
SETMORE_COOLDOWN_SECONDS=10
BOOKING_HORIZON_DAYS=56
MIN_LEAD_MINUTES=120
SLOT_STEP_MINUTES=15
CUSTOMER_SCAN_MAX_PAGES=20
# Secret: HMAC key for the customer index. A development fallback is used when empty.
CUSTOMER_HASH_SECRET=

PAYMENTS_MOCK_MODE=true
PAYMENTS_MOCK_SCENARIO=approve
SQUARE_ENVIRONMENT=sandbox
SQUARE_APPLICATION_ID=
SQUARE_LOCATION_ID=
# Secret: Square access token. Only needed with PAYMENTS_MOCK_MODE=false.
SQUARE_ACCESS_TOKEN=
SQUARE_VERSION=2026-11-18
SQUARE_DELAY_DURATION=PT48H
DEPOSIT_AMOUNT_CENTS=5000
CARD_FEE_BASIS_POINTS=0

# Cloudflare Turnstile test keys (always pass). Replace in production.
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
SALON_ALERT_EMAIL=
ALERT_FROM_EMAIL=booking-alerts@perfectionbyriri.com
