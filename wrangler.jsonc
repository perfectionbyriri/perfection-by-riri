{
  "$schema": "https://unpkg.com/wrangler/config-schema.json",
  "name": "perfection-by-riri",
  "main": "worker/src/index.js",
  "compatibility_date": "2026-11-03",
  "workers_dev": true,
  "previews": {},
  "assets": {
    "directory": "./New Perfection",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "base_path": "/"
  },
  "observability": {
    "enabled": true
  },
  // Fail-closed production defaults: without the secrets below, every
  // /api/booking/* request answers 500 MISCONFIGURED and static pages are
  // unaffected. Local development overrides these through .dev.vars.
  // Secrets (wrangler secret put): SETMORE_REFRESH_TOKEN, SQUARE_ACCESS_TOKEN,
  // CUSTOMER_HASH_SECRET, TURNSTILE_SECRET_KEY.
  "vars": {
    "ENVIRONMENT": "production",
    "ALLOWED_ORIGINS": "https://perfectionbyriri.com",
    "STUDIO_TIMEZONE": "America/Los_Angeles",
    "SETMORE_MOCK_MODE": "false",
    "PAYMENTS_MOCK_MODE": "false",
    "SETMORE_ACCOUNT_ID": "1a47bbdd-c70e-402d-9bcb-1c739d6752ae",
    "SETMORE_PROVIDER_ID": "b0bfa3b4-b043-4cec-b841-017a716974fd",
    "SQUARE_ENVIRONMENT": "production",
    "SQUARE_VERSION": "2026-11-18",
    "SQUARE_DELAY_DURATION": "PT48H",
    "DEPOSIT_AMOUNT_CENTS": "5000",
    "CARD_FEE_BASIS_POINTS": "0",
    "ALERT_FROM_EMAIL": "booking-alerts@perfectionbyriri.com"
  },
  // No id: Wrangler provisions the namespace on deploy (automatic provisioning).
  "kv_namespaces": [
    { "binding": "BOOKING_KV" }
  ],
  // The binding supports only 10 s or 60 s periods, so POSTs are limited to
  // 5 per minute per IP and location (approximate), not 5 per 10 minutes.
  "ratelimits": [
    { "name": "RATE_LIMITER_GET", "namespace_id": "1001", "simple": { "limit": 60, "period": 60 } },
    { "name": "RATE_LIMITER_POST", "namespace_id": "1002", "simple": { "limit": 5, "period": 60 } }
  ],
  "send_email": [
    { "name": "ALERT_EMAIL" }
  ],
  "triggers": {
    "crons": ["*/15 * * * *"]
  }
}
